{
  "name": "tress-site",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../packages/workspaces run build && npm run wasm",
    "dev": "farm dev",
    "demo:local": "node scripts/local-demo.mjs",
    "prebuild": "npm --prefix ../packages/workspaces run build && npm run wasm",
    "build": "farm build",
    "preview": "farm preview",
    "test:config": "node --test scripts/demo-config.test.mjs",
    "test:install": "node --test scripts/install.test.mjs",
    "test:relay": "node --test scripts/relay.test.mjs",
    "test:markdown": "node --test scripts/markdown.test.mjs",
    "test:sessions": "node --test scripts/sessions.test.mjs",
    "test:connect": "node --test scripts/connect.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-sessions.mjs",
    "test:host": "node --test scripts/local-demo.test.mjs scripts/workspace-info.test.mjs scripts/managed.test.mjs scripts/managed-backend.test.mjs scripts/demo-config.test.mjs scripts/markdown.test.mjs scripts/sessions.test.mjs scripts/health-policy.test.mjs scripts/connect.test.mjs && node scripts/verify-workspaces.mjs && node scripts/verify-managed-boot.mjs && node scripts/verify-sessions.mjs && node scripts/verify-health-policy.mjs && node scripts/verify-connected-agent.mjs",
    "test:host:dev": "node scripts/verify-workspaces.mjs --dev",
    "test:sandbox:live": "node --env-file-if-exists=.env.local scripts/verify-live-sandbox.mjs",
    "wasm": "node scripts/build-wasm.mjs",
    "wasm:node": "node scripts/build-wasm.mjs nodejs",
    "test:policy": "node --test scripts/health-policy.test.mjs"
  },
  "dependencies": {
    "@assistant-ui/tap": "^0.9.19",
    "@farm.js/core": "0.1.0-beta.104",
    "@farm.js/wasm": "0.1.0-beta.0",
    "@tress/workspaces": "file:../packages/workspaces",
    "@vercel/functions": "^3.9.9",
    "@vercel/sandbox": "^3.5.0",
    "ai": "^7.0.114",
    "harness-sdk": "file:vendor/harness-sdk-0.3.0.tgz",
    "just-bash": "^3.4.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "statewire": "^0.19.4"
  },
  "devDependencies": {
    "@farm.js/cli": "0.1.0-beta.104",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  },
  "overrides": {
    "@farm.js/wasm": {
      "@farm.js/core": "$@farm.js/core"
    }
  }
}
